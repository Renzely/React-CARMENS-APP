{
  "expo": {
    "name": "CB Inventory",
    "slug": "CarmensBest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/CARMEN_notxt.png",
    "scheme": "towi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/CARMEN_notxt.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bmp.CarmensBest"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/CARMEN_LOGO.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16960a76-e2f1-468c-9345-870ccb3d7303"
      }
    },
    "owner": "harold16"
  }
}
